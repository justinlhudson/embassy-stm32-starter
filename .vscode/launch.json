{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug example (STM32F413ZH)",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo-build-example-stm32f413",
      "connectUnderReset": true,
      "chip": "STM32F413ZH",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/example"
        }
      ]
    },
